{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:web"
      ],
      "port": 5180
    },
    {
      "name": "web+ai",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export SCENARIO_PORT=8797; pnpm --filter @netgongbu/server dev & pnpm --filter @netgongbu/web exec vite --port 5190 --strictPort"
      ],
      "port": 5190
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@netgongbu/web",
        "exec",
        "vite",
        "--port",
        "5182",
        "--strictPort"
      ],
      "port": 5182
    }
  ]
}