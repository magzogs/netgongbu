{
  "name": "@netgongbu/server",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API for the web viewer: scenarios from the connected AI (validated and stored), and the AI connection itself (sign-in, keys, models, streamed answers)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:fake": "tsx watch scripts/fake-ai.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@hono/node-server": "2.1.3",
    "@netgongbu/ai": "workspace:*",
    "@netgongbu/llm": "workspace:*",
    "@netgongbu/schema": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
