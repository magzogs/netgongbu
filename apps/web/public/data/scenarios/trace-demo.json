                "sources": {
                  "src": "observed",
                  "dst": "observed",
                  "ttl": "typical",
                  "protocol": "typical"
                }
              },
              {
                "name": "UDP",
                "fields": {
                  "srcPort": "임시 포트",
                  "dstPort": "53"
                },
                "sources": {
                  "srcPort": "typical",
                  "dstPort": "typical"
                }
              },
              {
                "name": "DNS",
