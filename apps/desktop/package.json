    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "maxmind": "5.0.7",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "vite": "7.3.6",
    "zod": "4.6.5"
