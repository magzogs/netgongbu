{
  "name": "@netgongbu/desktop",
  "version": "0.1.0",
  "productName": "Net Gongbu",
  "private": true,
  "description": "Net Gongbu desktop app: the viewer plus a real browser and the OS tools to measure where a page load goes",
  "author": "magzog",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "electron-vite build && tsx e2e/smoke.mts",
    "measure": "tsx e2e/measure.mts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@netgongbu/ai": "workspace:^",
    "@netgongbu/bridge": "workspace:^",
    "@netgongbu/llm": "workspace:^",
    "@netgongbu/schema": "workspace:^",
    "@netgongbu/trace": "workspace:^",
    "@types/node": "24.13.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "maxmind": "5.0.7",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "vite": "7.3.6",
    "zod": "4.6.5"
  }
}
